{
  "name": "samplex",
  "version": "0.1.4",
  "description": "Deploy static sites to shareable preview URLs from the command line",
  "keywords": [
    "cli",
    "hosting",
    "preview-url",
    "sample app",
    "share"
  ],
  "homepage": "https://sample.app",
  "license": "Apache-2.0",
  "author": "Rahul Mehra",
  "repository": {
    "type": "git",
    "url": "https://github.com/genmod-ai/samplex.git"
  },
  "bin": {
    "samplex": "dist/index.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "picospinner": "^3.0.0",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "tsdown": "^0.21.2",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.10"
}
