    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "picospinner": "^3.0.0",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "tsdown": "^0.21.2",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  }
}
