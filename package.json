{
  "name": "samplex",
  "version": "0.1.4",
  "description": "Deploy static sites to shareable preview URLs from the command line",
  "homepage": "https://sample.app",
  "license": "Apache-2.0",
  "author": "Genmod",
  "bin": {
    "samplex": "dist/index.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
